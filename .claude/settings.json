{
  "permissions": {
    "allow": [
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(node scripts/*)",
      "Bash(node --test*)"
    ],
    "deny": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/protect-profile.js"
          },
          {
            "type": "command",
            "command": "node scripts/hooks/guard-files.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-bash.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/prettify.mjs",
            "statusMessage": "Running prettier"
          }
        ]
      }
    ]
  }
}
