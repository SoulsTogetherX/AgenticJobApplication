# Personal data — never commit (contains contact info, work history, Q&A answers)
# NOTE: must be profile/* (not profile/) — git never descends into a fully
# ignored directory, which would make the example-file negation dead.
profile/*
!profile/profile.example.yaml
jobs/

# Dependencies / build
node_modules/
*.log

# Playwright MCP browser artifacts (snapshots/console logs from apply sessions)
.playwright-mcp/

# Rendered artifacts outside jobs/
*.pdf
*.html
!templates/*.html
