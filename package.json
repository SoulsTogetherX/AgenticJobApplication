{
  "name": "agentic-job-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Code-driven job application pipeline: tailor resume & cover letter from an approved fact profile, verify truthfulness, render PDFs.",
  "scripts": {
    "test": "node .github/workflows/test-gate.mjs full",
    "test:raw": "node --test",
    "test:security": "node .github/workflows/test-gate.mjs security",
    "reap": "node .github/workflows/scaffolding-reaper.mjs",
    "browser:install": "node node_modules/playwright-core/cli.js install chromium",
    "verify": "node scripts/documents/verify-claims.mjs"
  },
  "phases": {
    "order": [
      "phase-1",
      "phase-2",
      "phase-3",
      "phase-4"
    ],
    "current": "phase-1"
  },
  "testGate": {
    "full": {
      "floor": 1186,
      "maxTodo": 0
    },
    "security": {
      "floor": 224,
      "maxTodo": 0,
      "requireDirs": [
        "tests/security"
      ],
      "paths": [
        "tests/security/",
        "tests/lib/untrusted.test.mjs",
        "tests/documents/verify-claims.test.mjs"
      ]
    }
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6"
  }
}
