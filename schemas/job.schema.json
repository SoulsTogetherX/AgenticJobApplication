{
  "$comment": "Shape of jobs/<slug>/job.json — the captured job posting. Validated by validateJob() in scripts/lib.mjs.",
  "type": "object",
  "required": ["slug", "company", "title"],
  "properties": {
    "slug": { "type": "string", "description": "kebab-case folder name, e.g. acme-senior-fullstack" },
    "company": { "type": "string" },
    "title": { "type": "string" },
    "source_url": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "captured_at": { "type": ["string", "null"], "description": "YYYY-MM-DD" },
    "description": { "type": ["string", "null"], "description": "full posting text, verbatim" },
    "requirements": { "type": "array", "items": { "type": "string" } },
    "questions": {
      "type": "array",
      "description": "application-form questions encountered for this job",
      "items": { "type": "string" }
    }
  }
}
